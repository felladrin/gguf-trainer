.DS_Store

# Working directories: models, tokens and corpora are outputs, never source.
# Leading slashes matter: an unanchored `data/` also swallows src/data/, which is
# source, and a new file there is then invisible to git rather than rejected.
/out/
/data/
/demo-out/
# Downloaded base checkpoints, converted on the way in.
/base/

# Raw and pretokenized corpora: downloaded or derived, never source.
/corpus/
# Local run artifacts from before the CLI: checkpoints, token streams, logs.
/examples/
# Downloaded validation sets and eval output.
/evaldata/

# Agent scratch, not project source.
/memory/
/.consult/
