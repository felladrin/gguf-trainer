.DS_Store

# Demo output — regenerated by `deno task demo` / `demo:gpu` / `streaming`, not source.
examples/*.gguf
examples/*.tokens
examples/*.tokenizer.json
# Raw + pretokenized corpora (downloaded/derived, not source; see examples/pretokenize.ts).
corpus/
memory/

# Optimizer-state sidecars and training logs — run artifacts, regenerated per run.
examples/*.optstate
examples/*.log
