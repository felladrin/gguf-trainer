{
  "name": "gguf-trainer",
  "version": "0.1.0",
  "exports": "./src/index.ts",
  "tasks": {
    "demo": "deno run -A examples/demo.ts",
    "demo:node": "node --experimental-strip-types examples/demo.ts",
    "demo:gpu": "deno run -A examples/demo_gpu.ts",
    "streaming": "deno run -A examples/train_streaming.ts",
    "test": "deno run -A tests/gradcheck.ts && deno run tests/gpu_parity.ts",
    "test:node": "node --experimental-strip-types tests/gradcheck.ts && node --experimental-strip-types tests/gpu_parity.ts"
  },
  "fmt": {
    "lineWidth": 100
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "dom"]
  }
}
