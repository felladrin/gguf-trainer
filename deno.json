{
  "name": "gguf-trainer",
  "version": "0.1.0",
  "exports": "./src/index.ts",
  "imports": {
    "@huggingface/jinja": "npm:@huggingface/jinja@0.3.3",
    "hyparquet": "npm:hyparquet@1.17.1"
  },
  "tasks": {
    "demo": "deno run -A examples/demo.ts",
    "demo:node": "node --experimental-strip-types examples/demo.ts",
    "demo:gpu": "deno run -A examples/demo_gpu.ts",
    "streaming": "deno run -A examples/train_streaming.ts",
    "pretokenize": "deno run -A examples/pretokenize.ts corpus/tinystories-valid.txt examples/tinystories 8192 10",
    "prepare:pretrain": "deno run -A examples/prepare_pretrain.ts",
    "train:tinystories": "deno run -A examples/train_tinystories.ts",
    "mup:check": "deno run -A examples/mup_coord_check.ts",
    "eval:completions": "bash examples/eval_completions.sh",
    "webui": "deno task webui:build && deno task webui:server",
    "webui:build": "cd web/client && npm install && npm run build",
    "webui:server": "deno run -A web/server/main.ts",
    "webui:dev": "cd web/client && npm run dev",
    "test": "deno run tests/eta_fmt.ts && deno run -A tests/gradcheck.ts && deno run tests/gpu_parity.ts",
    "test:node": "node --experimental-strip-types tests/eta_fmt.ts && node --experimental-strip-types tests/gradcheck.ts && node --experimental-strip-types tests/gpu_parity.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": ["web/client", "web/.data"]
  },
  "lint": {
    "exclude": ["web/client", "web/.data"]
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "dom"]
  }
}
